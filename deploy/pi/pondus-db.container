# Quadlet-Unit für PostgreSQL. Wird NICHT automatisch aktualisiert (kein AutoUpdate):
# Major-Upgrades brauchen pg_upgrade/dump+restore und bleiben eine bewusste Entscheidung.
[Unit]
Description=Pondus PostgreSQL

[Container]
ContainerName=pondus-db
Image=docker.io/library/postgres:17-alpine
Network=pondus.network
EnvironmentFile=%h/projects/pondus/.env
Environment=POSTGRES_USER=pondus
Environment=POSTGRES_DB=pondus
# Bestehendes Volume aus dem compose-Stack weiterverwenden (keine Datenmigration nötig).
Volume=pondus_pgdata:/var/lib/postgresql/data
HealthCmd=pg_isready -U pondus -d pondus
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=20s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
