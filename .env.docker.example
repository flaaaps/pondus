# Copy to .env.docker (gitignored). Used by docker-compose.yml for db and api.
# Generate each secret with: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60
CORS_ORIGINS=
RATE_LIMIT_MAX=300
