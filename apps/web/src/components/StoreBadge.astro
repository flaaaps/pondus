---
/**
 * "Coming to the App Store". Deliberately not Apple's official badge: that one may only be used
 * with a live App Store link (docs/HOMEPAGE.md, Offen).
 */
interface Props {
  tone?: "dark" | "light"
}
const { tone = "dark" } = Astro.props
---

<span class:list={["badge", tone]} role="note">
  <svg width="18" height="22" viewBox="0 0 18 22" aria-hidden="true">
    <rect x="1.5" y="1" width="15" height="20" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
    <rect x="6.5" y="3.4" width="5" height="1.6" rx="0.8" fill="currentColor"></rect>
  </svg>
  <span class="text">
    <span class="small">Für iPhone</span>
    <span class="big">Bald im App Store</span>
  </span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px 10px 16px;
    border-radius: 14px;
    line-height: 1.15;
  }
  .dark {
    background: var(--text);
    color: var(--bg);
  }
  .light {
    background: var(--night-text);
    color: var(--night);
  }
  .text {
    display: grid;
  }
  .small {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.75;
  }
  .big {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
