---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"

/** A screenshot in a plain iPhone frame drawn with CSS (no third-party mockups). */
interface Props {
  src: ImageMetadata
  alt: string
  /** Rendered width in CSS pixels at the largest breakpoint. */
  width?: number
  eager?: boolean
  class?: string
}
const { src, alt, width = 300, eager = false, class: className } = Astro.props
---

<figure class:list={["phone", className]} style={`--w: ${width}px`}>
  <Image
    src={src}
    alt={alt}
    widths={[width, width * 2]}
    sizes={`(max-width: 700px) 70vw, ${width}px`}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    format="webp"
    quality={86}
  />
</figure>

<style>
  .phone {
    margin: 0;
    width: min(var(--w), 72vw);
    padding: calc(min(var(--w), 72vw) * 0.03);
    border-radius: calc(min(var(--w), 72vw) * 0.165);
    background: #15171b;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 0 0 1px rgb(17 19 23 / 0.12),
      var(--shadow-float);
  }
  .phone :global(img) {
    width: 100%;
    aspect-ratio: 1206 / 2622;
    object-fit: cover;
    border-radius: calc(min(var(--w), 72vw) * 0.137);
  }
</style>
