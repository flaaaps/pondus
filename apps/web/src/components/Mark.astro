---
/** The Pondus mark: three rising bars, the top one in Ember (brand/pondus-mark.svg). */
interface Props {
  size?: number
  class?: string
}
const { size = 28, class: className } = Astro.props
---

<svg class={className} width={size} height={size} viewBox="40 48 176 152" aria-hidden="true">
  <rect x="40" y="160" width="56" height="40" rx="12" fill="currentColor"></rect>
  <rect x="40" y="104" width="112" height="40" rx="12" fill="currentColor"></rect>
  <rect x="40" y="48" width="176" height="40" rx="12" fill="#FF7A1A"></rect>
</svg>
