# Copy to .env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=4010
LOG_LEVEL=info
# PostgreSQL. `pnpm db:dev` starts an embedded cluster on this URL when no server is available.
DATABASE_URL=postgres://pondus:pondus@127.0.0.1:54329/pondus
# Secrets: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60
# Comma-separated origins allowed for CORS (web tooling only; the iOS app needs none)
CORS_ORIGINS=
RATE_LIMIT_MAX=300
